{
  "version": 3,
  "description": "Replica catalog: the same contracts as model_catalog.json but backed by untrained, contract-compatible TorchScript replicas. Artifacts are generated on demand by src/build_model_replicas.py into {replica_root} (default /tmp/$USER/model_inspection_replicas, override with MODEL_REPLICA_ROOT). Suitable for workflow and performance-method validation, not for scientific results.",
  "groups": {
    "TS": {
      "long_name": "Terrain Solver",
      "explanation": "Models with the fixed 18-to-1 patch input/output pattern: two [B,1,3,3] tensors (local water height and terrain) produce one scalar [B] forecast per sample."
    },
    "TBL": {
      "long_name": "Turbulent Boundary Layer",
      "explanation": "Flow-modeling sequence models with the sequence length fixed to 5: a packed [B,5,512] input produces a [B,2,512] forecast."
    }
  },
  "models": [
    {
      "id": "watercnn",
      "display_name": "WaterCNN",
      "short_name": "WaterCNN",
      "long_name": "[TS] WaterCNN",
      "group": "TS",
      "notes": "Untrained replica.",
      "uses_tf32": false,
      "family": "local_surrogate",
      "artifact_cpu": "{replica_root}/watercnn_cpu.pt",
      "artifact_cuda": "{replica_root}/watercnn_cuda.pt",
      "io_layout": "split_3x3",
      "backend": "torchscript",
      "inputs": [
        {
          "name": "x_water",
          "shape": [
            null,
            1,
            3,
            3
          ],
          "dtype": "float32"
        },
        {
          "name": "x_terrain",
          "shape": [
            null,
            1,
            3,
            3
          ],
          "dtype": "float32"
        }
      ],
      "outputs": [
        {
          "name": "y",
          "shape": [
            null
          ],
          "dtype": "float32"
        }
      ],
      "replica": "watercnn"
    },
